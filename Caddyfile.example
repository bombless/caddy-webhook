# Merge these handlers into the existing site block. Keep the existing
# reverse_proxy handler as the final fallback for unrelated application paths.
#
# The webhook serves only control-plane JSON/uploads. Static game files are
# served directly by Caddy from persistent storage, outside the replaceable
# current site release.

handle /_deploy* {
    reverse_proxy 127.0.0.1:8765
}

handle /_games/registry.json {
    root * /var/lib/static-deploy/games
    rewrite * /registry.json
    header Cache-Control "no-store"
    file_server
}

@game_packages path /games/*
header @game_packages Access-Control-Allow-Origin "*"
header @game_packages X-Content-Type-Options "nosniff"

handle_path /games/* {
    root * /var/lib/static-deploy/games
    @wasm path *.wasm
    header @wasm Content-Type "application/wasm"
    file_server
}

handle_path /app/* {
    root * /var/lib/static-deploy/current
    file_server
}
